NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
BACKEND_API_URL=http://127.0.0.1:4000/api/v1
ADS_ENABLED=false
# Local visual test mode: shows labelled placeholder blocks without loading AdSense.
ADS_TEST_MODE=false
# Public origin for /uploads images in the browser. Required in production because BACKEND_API_URL is internal.
NEXT_PUBLIC_MEDIA_URL=
# Comma-separated article types to expose publicly. Leave empty to keep all article families unpublished.
NEXT_PUBLIC_ARTICLE_TYPES=
# Set true/false to enable or disable ?page= pagination on article detail pages.
NEXT_PUBLIC_ARTICLE_DETAIL_PAGINATION=false
# On-demand revalidation (/api/admin/cache/clear). The backend sends this value in X-Cache-Clear-Token.
# Either name works; must match the backend's CACHE_CLEAR_TOKEN (or REVALIDATE_SECRET).
CACHE_CLEAR_TOKEN=
# REVALIDATE_SECRET=
# Optional rollout allowlist for /sitemaps/course-colleges.xml (comma-separated listing keys, e.g. mba,btech,bba).
# Leave empty to include every course listing with >= 15 colleges.
LISTING_SITEMAP_KEYS=

# Seconds before the student registration popup opens (default 5; 0 = immediately). NEXT_PUBLIC_*: restart dev / rebuild after changing.
NEXT_PUBLIC_STUDENT_POPUP_DELAY_SECONDS=5

# Upload images on S3 (original + .w{W}.webp size variants, see lib/image.ts). Leave empty to serve /uploads from the API.
# Production: NEXT_PUBLIC_IMAGE_BASE_URL=https://cd-mrd-file-storage.s3.ap-south-1.amazonaws.com/cd/uploads/public
NEXT_PUBLIC_IMAGE_BASE_URL=

# Google reCAPTCHA site key (public, v2 "I'm not a robot" checkbox). Used by components/Recaptcha.tsx.
# Never put the secret key here; it belongs in the backend .env (RECAPTCHA_SECRET_KEY).
# NEXT_PUBLIC_RECAPTCHA_ENABLED=false skips the widget (local tests only). Missing or any other value keeps it enabled.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_RECAPTCHA_ENABLED=true

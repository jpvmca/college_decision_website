NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_API_URL=http://127.0.0.1:4000/api/v1
# Public origin for /uploads images in the browser. Required in production because BACKEND_API_URL is internal.
NEXT_PUBLIC_MEDIA_URL=
# Comma-separated article types to expose publicly. Leave empty to keep all article families unpublished.
NEXT_PUBLIC_ARTICLE_TYPES=
# Set true/false to enable or disable ?page= pagination on article detail pages.
NEXT_PUBLIC_ARTICLE_DETAIL_PAGINATION=false
# On-demand revalidation (/api/admin/cache/clear). The backend sends this value in X-Cache-Clear-Token.
# Either name works; must match the backend's CACHE_CLEAR_TOKEN (or REVALIDATE_SECRET).
CACHE_CLEAR_TOKEN=
# REVALIDATE_SECRET=
# Optional rollout allowlist for /sitemaps/course-colleges.xml (comma-separated listing keys, e.g. mba,btech,bba).
# Leave empty to include every course listing with >= 15 colleges.
LISTING_SITEMAP_KEYS=
